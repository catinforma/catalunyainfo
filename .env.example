# ---------------------------------------------------------------------------
# CatalunyaInfo — environment
# Copy to .env.local for local development. Never commit a filled-in copy.
# In Vercel, set these per environment (Production / Preview / Development).
# ---------------------------------------------------------------------------

# Postgres. Use the POOLED connection string in Production and Preview
# (serverless functions open a connection per invocation); drizzle-kit
# migrations want the non-pooled one.
DATABASE_URL=
# Optional: used by `npm run db:migrate` when the pooler cannot run DDL.
POSTGRES_URL_NON_POOLING=
# Connections per serverless instance. Keep at 1 unless you know otherwise.
DATABASE_POOL_MAX=1
# Set to "true" to log every SQL statement in development.
DRIZZLE_LOG=false

# ---------------------------------------------------------------------------
# Indexing
# ---------------------------------------------------------------------------
# The master switch for crawling. While this is anything other than "true",
# robots.txt disallows everything and every page sends X-Robots-Tag: noindex.
# Set it to "true" in Production ONLY, and only once real content is live.
# Never set it in Preview: that is what keeps *.vercel.app out of the index.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# GA4 measurement id. Leave empty and no analytics code is shipped at all —
# and the cookie banner does not appear, because there is nothing to consent to.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/publish-scheduled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Search Console (optional)
# ---------------------------------------------------------------------------
# The token from the HTML-tag verification method, if you use it instead of DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
