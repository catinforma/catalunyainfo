# -----------------------------------------------------------------------------
# CatalunyaInfo: production environment for the VPS
#
# Lives at /srv/catalunyainfo/shared/.env.production, owned by root, mode 600.
# provision.sh copies this template there once and never overwrites it.
# Edit it ON THE SERVER only:   sudoedit /srv/catalunyainfo/shared/.env.production
# Never paste a value into a chat, a ticket or a commit.
#
# Read by:
#   - systemd (catalunyainfo.service, catalunyainfo-cron.service) at start, as root;
#   - deploy.sh, via `sudo -n cat`, to load the BUILD-time variables for `next build`.
#
# Syntax (systemd EnvironmentFile, which deploy.sh parses the same way):
#   KEY=value, one per line. No `export`, no spaces around `=`.
#   Quotes are optional; a value is taken literally to the end of the line.
#   Whole-line comments only (`#` inside a value is part of the value).
#   URL-encode special characters in database passwords (@ : / ? # %).
#
# Columns in the comments: [build] read by `next build` (inlined or baked
# into prerendered pages) - [run] read by the running server - [secret].
# A [build] variable changed here needs a new deploy, not just a restart.
#
# Do NOT set NODE_ENV, PORT, HOSTNAME or NEXT_OUTPUT here: the unit and
# deploy.sh set them, and this file would override the unit. deploy.sh refuses
# to build if it finds them. Do NOT set any VERCEL_* variable: VERCEL_ENV=preview
# here would noindex the whole site.
# -----------------------------------------------------------------------------

# --- Environment -------------------------------------------------------------

# [build+run] Deployment environment when VERCEL_ENV is absent (src/lib/site.ts
# deployEnv()). "production" on this server; "preview" on a staging server
# (forces noindex everywhere). Without it a production build still counts as
# production, but say it explicitly.
SITE_ENV=production

# [build+run] Master indexing switch. Inlined at build time (NEXT_PUBLIC_) and
# used by next.config.ts headers, the proxy, robots.txt and the sitemaps.
# Production today: true (the live site is indexable). Non-canonical hosts
# (the preview hostname, the raw IP) stay noindex whatever this says.
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Database ----------------------------------------------------------------

# [build+run] [secret] REQUIRED. The Postgres URL the site uses. Wins over the
# three below. Today: Supabase (eu-west-1) transaction pooler, port 6543, with
# ?sslmode=require. Get it from Supabase -> Project Settings -> Database ->
# Connection string (Vercel keeps it as a Sensitive variable: it cannot be
# read back from there). The build needs it: generateStaticParams lists every
# published page, and pages prerendered without it bake empty states for a day.
APP_DATABASE_URL=CHANGE_ME

# [build+run] [secret] Fallback when APP_DATABASE_URL is empty (written by the
# Neon integration on Vercel). Leave empty on the VPS.
DATABASE_URL=

# [build+run] [secret] Second fallback (Vercel/Neon integration). Leave empty.
POSTGRES_URL=

# [build+run] [secret] Last fallback, and the non-pooled URL that
# `npm run db:migrate` (drizzle-kit) prefers when the pooler refuses DDL.
# Optional; set only if you run migrations from the server.
POSTGRES_URL_NON_POOLING=

# [build+run] Connections per Node process (default 1, sized for serverless).
# A long-running server benefits from a few: 5 is plenty for one instance and
# well inside the Supabase pooler's client limit. Each build worker also opens
# its own pool.
DATABASE_POOL_MAX=5

# [run] "true" logs every SQL statement. Keep false in production.
DRIZZLE_LOG=false

# --- Scheduled jobs and deploy-time endpoints --------------------------------

# [run] [secret] REQUIRED. Bearer token for /api/cron/publish-scheduled (called
# by catalunyainfo-cron.timer), /api/admin/publish and /api/admin/migrate.
# Use the SAME value as Vercel production (the owner's local .cron-secret) so
# existing publish commands keep working after the cutover. Or rotate: then
# update .cron-secret and Vercel too. No trailing newline or spaces.
CRON_SECRET=CHANGE_ME

# --- Analytics and ads -------------------------------------------------------

# [build] GA4 measurement id (G-XXXXXXXXXX), inlined into the client bundle.
# Empty = no analytics code and no cookie banner. Copy the production value
# from Vercel -> Project -> Settings -> Environment Variables, or GA4 itself;
# leaving it empty silently stops analytics after the cutover.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# [build+run] AdSense publisher id (pub-XXXXXXXXXXXXXXXX) served in /ads.txt
# (prerendered at build, revalidated hourly). Empty = /ads.txt answers 404,
# which is what production serves today.
ADSENSE_PUBLISHER_ID=

# --- Contact form email (optional) -------------------------------------------

# [run] [secret] Resend API key. Without it, messages are still stored and
# readable in /admin/messages; with it, an email notification is sent too.
RESEND_API_KEY=

# [run] Sender, e.g. "CatalunyaInfo <avisos@catalunyainfo.com>" (must be a
# verified Resend sender). Empty = Resend's shared onboarding sender.
CONTACT_FROM=

# [run] Recipient. Empty = SITE.contactEmail in src/lib/site.ts.
CONTACT_TO=

# -----------------------------------------------------------------------------
# Not for this file (for reference: every other variable the code reads):
#   NODE_ENV, PORT, HOSTNAME        set by catalunyainfo.service
#   NEXT_OUTPUT=standalone          set by deploy.sh for the build only
#   NEXT_TELEMETRY_DISABLED=1       set by the unit and deploy.sh
#   NEXT_PHASE                      set by Next itself during `next build`
#   VERCEL_ENV, VERCEL_URL,
#   VERCEL_BRANCH_URL               Vercel system variables; must stay unset here
#   SEO_ORIGIN, CI_PASSWORD         operator scripts in scripts/, run locally
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION appears in the repo's .env.example but
# no code reads it any more (Search Console is verified by DNS TXT record).
# -----------------------------------------------------------------------------
